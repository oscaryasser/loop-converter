rules_version = '2';

// Copy-paste this whole file into Firebase console -> Firestore -> Rules.
//
// The tradeoff, in one sentence: there is no login, so anyone who
// discovers your exact random family path could read and edit the data —
// the long random ID in the app is the only lock on the door.
//
// Everything OUTSIDE that one path is denied, so random internet
// scanners hitting your project get nothing.

service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId} {
      allow read, write: if true;
      match /dogs/{dogId} {
        allow read, write: if true;
      }
    }
  }
}
